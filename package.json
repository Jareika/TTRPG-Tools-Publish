{
  "name": "ttrpg-tools-publish",
  "version": "1.1.4",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "audit": "npm audit",
    "audit:json": "npm audit --json",
    "deps:check": "npm ls minimatch ajv flatted brace-expansion picomatch yaml"
  },
  "overrides": {
    "eslint-plugin-n@17.10.3": {
      "minimatch@8.0.6": {
        "brace-expansion": "2.1.4"
      }
    },
    "eslint-plugin-react@7.37.3": {
      "minimatch@8.0.6": {
        "brace-expansion": "2.1.4"
      }
    },
    "eslint-plugin-import@2.32.0": {
      "minimatch@8.0.6": {
        "brace-expansion": "2.1.4"
      }
    },
    "eslint-plugin-json-schema-validator@5.1.0": {
      "minimatch@8.0.6": {
        "brace-expansion": "2.1.4"
      }
    },
    "eslint": {
      "minimatch": "3.1.4",
      "ajv": "6.14.0",
      "flatted": "3.4.2",
      "brace-expansion": "1.1.18"
    },
    "@typescript-eslint/eslint-plugin": {
      "minimatch": "9.0.7",
      "brace-expansion": "2.1.4",
      "picomatch": "4.0.4"
    },
    "eslint-plugin-obsidianmd": {
      "minimatch": "8.0.6",
      "ajv": "8.18.0",
      "yaml": "2.8.3"
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "globals": "^16.5.0",
    "obsidian": "^1.13.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.48.0"
  },
  "allowScripts": {
    "esbuild@0.28.0": true
  }
}
